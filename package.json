{
  "name": "svelte-kit-tutorial",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && husky",
    "postinstall": "npm run prisma:generate",
    "reinstall": "rimraf node_modules .svelte-kit prisma/*/generated && npm install",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check src && eslint src",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "commit": "git-cz",
    "prisma:generate": "prisma generate --schema=prisma/mysql/schema.prisma",
    "prisma:create-migration-file": "prisma migrate dev --create-only --schema=prisma/mysql/schema.prisma --name",
    "prisma:exec-migrate": "prisma migrate dev --schema=prisma/mysql/schema.prisma",
    "prisma:reset": "prisma migrate reset --force --skip-seed --schema=prisma/mysql/schema.prisma",
    "ci": "run-s -c ci:*",
    "ci:lint": "npm run lint",
    "ci:test": "npm run test"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.4",
    "@types/node": "^22.14.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.3.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-svelte": "^3.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "git-cz": "^4.9.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.5.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.5.0",
    "rimraf": "^6.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.8",
    "@ai-sdk/svelte": "^2.1.8",
    "@auth/core": "^0.38.0",
    "@auth/prisma-adapter": "^2.8.0",
    "@auth/sveltekit": "^1.8.0",
    "@google-cloud/storage": "^7.16.0",
    "@google-cloud/vertexai": "^1.9.3",
    "@prisma/client": "^6.5.0",
    "ai": "^4.3.3",
    "flowbite": "^3.1.2",
    "flowbite-svelte": "^0.48.5",
    "flowbite-svelte-icons": "^2.1.0",
    "googleapis": "^148.0.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.9.1",
    "zod": "^3.24.2"
  },
  "lint-staged": {
    "*.{ts,tsx,svelte}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
